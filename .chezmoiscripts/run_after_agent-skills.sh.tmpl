#!/usr/bin/env bash
# Skill routing, two passes:
#   1) merge skill sources into ~/.agents/skills as symlinks — most agents
#      (Codex, Cursor, Gemini CLI, OpenCode, Amp) read that dir natively.
#      Sources are this repo's own skills/ plus the external repos cloned to
#      ~/.agents/sources/<name> via .chezmoiexternal.toml.
#   2) fan ~/.agents/skills out into agent dirs that don't (Claude Code)
# Collision precedence: real dirs in ~/.agents/skills (trials, `npx skills`
# installs) > sources in SOURCE_ROOTS order.
# Never touches ~/.agents/.skill-lock.json — owned by the `npx skills` CLI,
# which wipes lockfile versions it doesn't recognize.
# run_after_, not run_onchange_: skills move between source repos on pull, which no rendered-template hash can see.
set -euo pipefail

MERGED="$HOME/.agents/skills"
SOURCES_ROOT="$HOME/.agents/sources"
# Precedence order, first wins. This repo's own skills/ lead and are linked
# straight out of the chezmoi source dir, so editing one is live without an
# apply and no shared source can shadow a skill about this repo's mechanics.
SOURCE_ROOTS=(
  "{{ .chezmoi.sourceDir }}/skills"
  "$SOURCES_ROOT/private"
  "$SOURCES_ROOT/team"
  "$SOURCES_ROOT/public"
)
AGENT_SKILL_DIRS=("$HOME/.claude/skills")  # agents without native ~/.agents/skills support

mkdir -p "$MERGED"

# -- pass 1: rebuild source links (first-wins); real dirs are never touched
for entry in "$MERGED"/*; do
  [ -L "$entry" ] || continue
  target=$(readlink "$entry")
  for root in "${SOURCE_ROOTS[@]}"; do
    case "$target" in "$root"/*) rm -f "$entry"; break ;; esac
  done
done

for root in "${SOURCE_ROOTS[@]}"; do
  for skill in "$root"/skills/*/ "$root"/*/; do
    [ -f "${skill}SKILL.md" ] || continue
    name=$(basename "$skill")
    target="$MERGED/$name"
    [ -e "$target" ] || ln -s "${skill%/}" "$target"
  done
done

# -- pass 2: fan out into non-native agents, then prune dangling links
for agent_dir in "${AGENT_SKILL_DIRS[@]}"; do
  mkdir -p "$agent_dir"

  for entry in "$MERGED"/*; do
    [ -d "$entry" ] || continue  # follows symlinks; skips dangling ones
    name=$(basename "$entry")
    target="$agent_dir/$name"
    if [ -L "$target" ] || [ ! -e "$target" ]; then
      ln -sfn "$MERGED/$name" "$target"
    else
      echo "skip: $target is a local skill shadowing managed '$name'" >&2
    fi
  done

  for link in "$agent_dir"/*; do
    [ -L "$link" ] || continue
    case "$(readlink "$link")" in
      "$MERGED"/*) [ -e "$link" ] || rm -f "$link" ;;
    esac
  done
done
