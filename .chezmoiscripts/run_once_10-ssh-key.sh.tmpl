#!/usr/bin/env bash
{{ if eq .chezmoi.os "darwin" }}exit 0  # bootstrap.sh owns keys on macOS{{ end }}

# Generate an SSH key

set -euo pipefail

KEY="$HOME/.ssh/id_ed25519"
EMAIL="{{ .email | default "your_email@example.com" }}"

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

if [[ ! -f "$KEY" ]]; then
  ssh-keygen -t ed25519 -C "$EMAIL" -f "$KEY" -N ""
  chmod 600 "$KEY"
  chmod 644 "$KEY.pub"
fi

# Ensure ssh-agent has the key (best-effort)
if command -v ssh-agent >/dev/null 2>&1; then
  eval "$(ssh-agent -s)" >/dev/null 2>&1 || true
  ssh-add "$KEY" >/dev/null 2>&1 || true
fi

echo
echo "Public key:"
cat "$KEY.pub"
echo

